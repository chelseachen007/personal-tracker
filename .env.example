# Environment Variables for Personal Tracker

# JWT Secret (REQUIRED - change this in production!)
JWT_SECRET=your-strong-random-secret-key-change-this

# API Base URL for frontend (optional)
# Use actual server IP/hostname when deploying on Linux
API_BASE_URL=http://localhost:3001

# Example for remote deployment:
# API_BASE_URL=http://192.168.1.100:3001
# API_BASE_URL=http://your-domain.com

# ========== OCR Configuration ==========

# OCR Provider: baidu, tencent, local
OCR_PROVIDER=baidu

# Baidu OCR Credentials (get from https://cloud.baidu.com/product/ocr)
OCR_API_KEY=your-baidu-api-key
OCR_SECRET_KEY=your-baidu-secret-key
OCR_APP_ID=your-baidu-app-id

# Tencent OCR Credentials (alternative)
# OCR_TENCENT_SECRET_ID=your-secret-id
# OCR_TENCENT_SECRET_KEY=your-secret-key
